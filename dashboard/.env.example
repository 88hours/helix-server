# ---------------------------------------------------------------------------
# Helix Dashboard — Vite environment variables
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
#
# All VITE_* variables are embedded at build time and visible in the browser.
# Never put secrets here.
# ---------------------------------------------------------------------------

# Auth0 SPA application settings.
# Leave unset to disable auth (demo mode — no login required).
# See config.yaml auth0 section for setup instructions.
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.helix.yourapp.com
