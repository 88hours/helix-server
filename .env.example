# Helix — environment variable template
#
# Copy this file to .env and fill in the values.
# Never commit .env — it is in .gitignore.
#
# All variable *names* are the source of truth in config.yaml.
# The values below are placeholders only.

# ---------------------------------------------------------------------------
# LLM API keys
# At least one of these is required depending on which agents use which provider.
# Default: crash_handler and qa use anthropic; dev uses claude-code (no key needed).
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...        # only required if any agent uses provider: openrouter

# ---------------------------------------------------------------------------
# Redis
# Used for both shared incident state and the Redis Pub/Sub event bus.
# ---------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Sentry integration
# Set this to the Client Secret shown in your Sentry webhook settings.
# ---------------------------------------------------------------------------

SENTRY_WEBHOOK_SECRET=your-sentry-webhook-secret

# ---------------------------------------------------------------------------
# GitHub integration
# Personal access token (classic) or fine-grained token.
# Required scopes: contents (read/write), pull-requests (read/write)
# Also set github.target_repo in config.yaml to "owner/repo".
# ---------------------------------------------------------------------------

GITHUB_TOKEN=ghp_...

# ---------------------------------------------------------------------------
# JIRA integration
# API token generated at https://id.atlassian.com/manage-profile/security/api-tokens
# ---------------------------------------------------------------------------

JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@your-org.com
JIRA_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# ---------------------------------------------------------------------------
# Slack integration
# Bot token (xoxb-...) from your Slack app's OAuth & Permissions page.
# Required scopes: chat:write, chat:write.public
#
# SLACK_APPROVAL_CHANNEL: the channel ID (C...) or name (#channel) where
# Helix posts PR approval requests and escalation alerts.
# ---------------------------------------------------------------------------

SLACK_BOT_TOKEN=xoxb-...
SLACK_APPROVAL_CHANNEL=C0123456789

# ---------------------------------------------------------------------------
# Email notifications (SMTP)
# Works with any provider: Gmail, SendGrid, AWS SES, Mailgun, Postmark, etc.
# Sent alongside Slack for approval requests, escalations, and PR-merged confirmations.
# ---------------------------------------------------------------------------

# Option A — SendGrid API (preferred; set this and SMTP vars below are not needed)
SENDGRID_API_KEY=SG.xxxx             # SendGrid API key with "Mail Send" permission

# Option B — SMTP fallback (used when SENDGRID_API_KEY is not set)
# Works with Gmail, AWS SES, Mailgun, Postmark, etc.
SMTP_HOST=smtp.gmail.com             # or email-smtp.us-east-1.amazonaws.com, etc.
SMTP_PORT=587                        # 587 = STARTTLS (recommended), 465 = SSL
SMTP_USER=you@gmail.com              # your email address (Gmail) or SMTP username
SMTP_PASSWORD=your-app-password      # Gmail app password or SMTP password

# Always required (both options)
EMAIL_FROM=helix@acme.com            # sender address shown in emails
EMAIL_TO=oncall@acme.com             # comma-separated recipients, e.g. oncall@acme.com,cto@acme.com

# ---------------------------------------------------------------------------
# Optional — AWS EventBridge (only needed if HELIX_EVENT_BACKEND=eventbridge)
# ---------------------------------------------------------------------------

# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# HELIX_EVENTBRIDGE_BUS=helix-mvp        # defaults to helix-mvp

# ---------------------------------------------------------------------------
# Optional — runtime overrides
# ---------------------------------------------------------------------------

# HELIX_EVENT_BACKEND=redis              # "redis" (default) or "eventbridge"
# LOG_LEVEL=INFO                         # passed to Python logging

# Per-agent model/provider overrides (see config.yaml for defaults):
# HELIX_CRASH_HANDLER_PROVIDER=anthropic
# HELIX_CRASH_HANDLER_MODEL=claude-haiku-4-5-20251001
# HELIX_QA_PROVIDER=anthropic
# HELIX_QA_MODEL=claude-haiku-4-5-20251001
# HELIX_DEV_PROVIDER=claude-code
# HELIX_DEV_MODEL=claude-sonnet-4-6
# HELIX_CODE_QUALITY_PROVIDER=anthropic
# HELIX_CODE_QUALITY_MODEL=claude-sonnet-4-6
