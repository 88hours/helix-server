# ---------------------------------------------------------------------------
# Helix — environment variable template
# Copy to .env and fill in your values:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Anthropic API key — used by Crash Handler and QA agents
ANTHROPIC_API_KEY=

# Redis connection URL — omit to use local Docker Redis (docker compose --profile local)
REDIS_URL=

# Rollbar project access token — verified against each inbound webhook
ROLLBAR_ACCESS_TOKEN=

# GitHub personal access token — needs repo + issues scope
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Optional — Slack notifications
# Missing values are logged as a warning; the pipeline continues without them.
# ---------------------------------------------------------------------------

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=

# ---------------------------------------------------------------------------
# Optional — email notifications (SendGrid preferred, SMTP fallback)
# ---------------------------------------------------------------------------

# SendGrid (preferred)
SENDGRID_API_KEY=

# SMTP fallback (used only if SENDGRID_API_KEY is not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Sender and recipients
EMAIL_FROM=
EMAIL_TO=

# ---------------------------------------------------------------------------
# Optional — Auth0 (dashboard login via GitHub)
# Leave unset to disable auth (demo mode — no login required).
# See config.yaml auth0 section for setup instructions.
# ---------------------------------------------------------------------------

AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ---------------------------------------------------------------------------
# Optional — model overrides (defaults are set in config.yaml)
# ---------------------------------------------------------------------------

# HELIX_CRASH_HANDLER_PROVIDER=anthropic
# HELIX_CRASH_HANDLER_MODEL=claude-haiku-4-5-20251001
# HELIX_QA_PROVIDER=anthropic
# HELIX_QA_MODEL=claude-haiku-4-5-20251001
# HELIX_DEV_PROVIDER=claude-code
# HELIX_DEV_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Optional — logging
# ---------------------------------------------------------------------------

# LOG_LEVEL=INFO
